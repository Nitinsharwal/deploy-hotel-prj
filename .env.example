# ---- Google OAuth (Continue with Google) ----
# Create credentials: https://console.cloud.google.com/apis/credentials
#   1. Create a project + configure the OAuth consent screen
#   2. + Create Credentials → OAuth client ID → Web application
#      Authorized redirect URIs:
#         http://127.0.0.1:8000/accounts/google/login/callback/
#         https://<your-prod-domain>/accounts/google/login/callback/
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# ---- Cache (optional) ----
# Leave empty in dev → falls back to in-process LocMemCache (zero setup).
# In prod (or when running multiple gunicorn workers) point at a Redis
# instance so all workers share the cache state.
# Examples:
#   redis://127.0.0.1:6379/1                       (local)
#   rediss://default:PW@host:6380/0?ssl_cert_reqs=required   (Upstash / Redis Cloud)
